# Copy this file to .env and fill in your own values. Never commit .env.

# Only needed when MODEL starts with "gpt"
OPENAI_API_KEY=your-openai-api-key-here

# "llama3" (default, runs locally through Ollama), "deepseek-r1:1.5b", or an OpenAI model such as "gpt-4-turbo"
MODEL=llama3

# Optional: silences the LangChain USER_AGENT warning
USER_AGENT=telecare-rag-chatbot
